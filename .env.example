# Backend Environment Variables

# Anthropic API Key (required)
# Get your key from: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Scan directory to watch for new documents
# Default: ~/scans
SCAN_WATCH_DIR=/home/user/scans

# Data directory for SQLite and sorted documents
# Default: ./data
DATA_DIR=./data

# Directory for organized documents
# Default: ./data/sorted
SORTED_DIR=./data/sorted

# SQLite database path
# Default: ./data/docsort.db
DB_PATH=./data/docsort.db

# API server port
# Default: 5000
API_PORT=5000

# OCR concurrency (number of documents to process in parallel)
# Default: 2
OCR_CONCURRENCY=2

# OCR timeout in milliseconds
# Default: 120000 (2 minutes)
OCR_TIMEOUT=120000

# Google Drive OAuth Credentials (for Electron app)
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Frontend Environment Variables (for Next.js)

# API URL for frontend
# Default: http://localhost:5000/api
NEXT_PUBLIC_API_URL=http://localhost:5000/api
